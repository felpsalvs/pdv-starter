{
  "name": "soparia-pdv",
  "version": "1.0.0",
  "private": true,
  "description": "PDV simples e offline para a Soparia — frontend Svelte; o backend é o binário Go em cmd/pdv.",
  "scripts": {
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "postinstall": "npm run build",
    "check": "svelte-check --tsconfig frontend/tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.45.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.2",
    "cn": "^0.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
